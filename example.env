# Kopieren nach .env und ausfüllen:  cp example.env .env

# --- Telegram -------------------------------------------------------------
# Token von @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# Kommagetrennte Chat-IDs, die den Bot nutzen dürfen.
# Leer lassen: Wer zuerst /start schickt, wird Besitzer (Chat-ID wird angezeigt).
TELEGRAM_ALLOWED_CHAT_IDS=

# --- OpenRouter -----------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
# Delegate-Agent (spricht mit dir, verteilt Aufgaben) – günstiges Reasoning-Modell
MODEL_DELEGATE=inclusionai/ling-3.0-flash
# Denkaufwand des Delegate: low | medium | high (leer = Modell-Standard). low spart Tokens.
DELEGATE_REASONING_EFFORT=low
# Sub-Agents: Recherche (Browser), Angebot, Vollbewertung
MODEL_SUBAGENT=deepseek/deepseek-v4.1-flash
# Vorbewertung neuer Treffer und Zusammenfassungen
MODEL_FAST=google/gemini-2.5-flash-lite
# Alternativen (Preis pro 1 Mio. Tokens, Ein/Aus):
#   Aktuell: ling-3.0-flash $0.021/$0.063 · deepseek-v4.1-flash $0.03/$0.50 · gemini-2.5-flash-lite $0.10/$0.40
#   Delegate:   moonshotai/kimi-k2.6  $0.43/$1.83   deepseek/deepseek-v4-pro  $0.21/$0.42
#   Sub-Agents: deepseek/deepseek-v4-flash  $0.04/$0.08   google/gemini-3.1-flash-lite  $0.25/$1.50

# --- TypeSafe AI (Jev) ----------------------------------------------------
# Jev trifft die Bewertungs-Entscheidungen (Passung, Go/No-Go, Gewinnchance, Aufwand)
# mit Wahrscheinlichkeiten. Leer lassen = Bewertung nur per LLM.
# Key: https://console.typesafe.ai (aktuell Early Access / Warteliste)
TYPESAFE_API_KEY=
MODEL_JEV=jev-latest

# --- Suche auf service.bund.de -------------------------------------------
SEARCH_TERMS=Blendschutz,Sichtschutz,Sonnenschutz,Jalousien,Rollo,Vorhänge,Markisen,Rollladen,Raffstore,Insektenschutz,Lamellenvorhang,Plissee
SEARCH_CITY=Berlin
# Geo-ID des Ortes auf service.bund.de (Berlin = 14356). Leer = bundesweit.
SEARCH_OPENGEO_ID=14356
# Erlaubt: 10, 20, 30, 50, 75, 90
SEARCH_RADIUS_KM=50
# Wie oft automatisch gesucht wird (Minuten)
POLL_INTERVAL_MINUTES=360
# Ab dieser Passung (0-100) wird per Telegram gemeldet
MIN_SCORE_NOTIFY=50

# --- Browser / Abgabe -----------------------------------------------------
# false = Browserfenster sichtbar (praktisch zum Zuschauen/Debuggen)
PLAYWRIGHT_HEADLESS=true
# Sicherheitsschalter: nur bei true darf der Bot nach deiner Freigabe selbst abgeben.
ALLOW_AUTO_SUBMIT=false
